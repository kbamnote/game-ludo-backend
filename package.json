{
  "name": "backend-ludo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch & node --watch dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/accounts.mjs test/admin.mjs test/metaperson.mjs test/friends-rules.mjs test/public-tables.mjs test/snakes-rules.mjs test/match-pots.mjs test/voice-startup.mjs && node test/two-client-match.mjs"
  },
  "dependencies": {
    "face-api.js": "0.22.2",
    "fflate": "^0.8.2",
    "mongodb": "^7.9.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.7.0"
  }
}
